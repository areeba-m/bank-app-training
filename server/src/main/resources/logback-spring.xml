<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <!-- Pull in Spring Boot's own property/pattern/color/exception definitions
         (CONSOLE_LOG_PATTERN, FILE_LOG_PATTERN, %clr conversion rule, %wEx conversion rule, etc.) -->
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>

    <springProperty
            scope="context"
            name="LOG_DIR"
            source="logging.file.path"
            defaultValue="logs"/>

    <!-- Spring Boot's actual CONSOLE appender bean (name="CONSOLE").
         Identical output/colors/exception handling to an app with no custom logback config at all. -->
    <include resource="org/springframework/boot/logging/logback/console-appender.xml"/>

    <!-- Business/application logs -->
    <appender name="APPLICATION" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_DIR}/application.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_DIR}/application-%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
            <maxFileSize>10MB</maxFileSize>
            <maxHistory>30</maxHistory>
        </rollingPolicy>
        <encoder>
            <pattern>${FILE_LOG_PATTERN}</pattern>
        </encoder>
    </appender>

    <!-- Security logs -->
    <appender name="SECURITY" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_DIR}/security.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_DIR}/security-%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
            <maxFileSize>10MB</maxFileSize>
            <maxHistory>30</maxHistory>
        </rollingPolicy>
        <encoder>
            <pattern>${FILE_LOG_PATTERN}</pattern>
        </encoder>
    </appender>

    <!-- Error logs: ERROR level from anywhere in the app (business, security, or framework) -->
    <appender name="ERRORS" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_DIR}/error.log</file>
        <filter class="ch.qos.logback.classic.filter.ThresholdFilter">
            <level>ERROR</level>
        </filter>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_DIR}/error-%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
            <maxFileSize>10MB</maxFileSize>
            <maxHistory>30</maxHistory>
        </rollingPolicy>
        <encoder>
            <pattern>${FILE_LOG_PATTERN}</pattern>
        </encoder>
    </appender>

    <!-- Business modules: write to application.log, then propagate (additivity defaults to true)
         up to root, which handles console + error.log for everyone -->
    <logger name="com.redmath.account">
        <appender-ref ref="APPLICATION"/>
    </logger>
    <logger name="com.redmath.balance">
        <appender-ref ref="APPLICATION"/>
    </logger>
    <logger name="com.redmath.transactions">
        <appender-ref ref="APPLICATION"/>
    </logger>
    <logger name="com.redmath.transfer">
        <appender-ref ref="APPLICATION"/>
    </logger>
    <logger name="com.redmath.admin">
        <appender-ref ref="APPLICATION"/>
    </logger>
    <logger name="com.redmath.exception_utility">
        <appender-ref ref="APPLICATION"/>
    </logger>

    <!-- Auth/security modules: write to security.log, propagate up for console + error.log -->
    <logger name="com.redmath.authentication">
        <appender-ref ref="SECURITY"/>
    </logger>
    <logger name="com.redmath.security">
        <appender-ref ref="SECURITY"/>
    </logger>

    <!-- Root: Spring's default console behavior + centralized error file, for the whole app -->
    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="ERRORS"/>
    </root>

</configuration>
